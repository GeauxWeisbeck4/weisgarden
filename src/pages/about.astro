---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"35 year old full stack developer with a passion for building web applications and exploring new technologies.",
	title: "About Andrew",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About Andrew</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			Hi, I’m Andrew, a 35-year-old full stack developer with a passion for building web
			applications and exploring new technologies.
		</p>
		<p>Here are some things I like:</p>
		<ul class="list-inside list-disc" role="list">
			<li>Building Web Applications</li>
			<li>Software Design and Development</li>
			<li>
				Nebraska Cornhuskers, Kansas City Royals, New England Patriots, and Carolina Hurricanes
			</li>
			<li>Reading Science Fiction</li>
			<li>Writing - that is why I created this site!</li>
			<li>Entrepreneurship</li>
			<li>Learning and teaching others</li>
		</ul>
		<p>
			Check out the <a
				class="cactus-link inline-block"
				href="https://github.com/geauxweisbeck4/weisgarden"
				rel="noreferrer"
				target="_blank">repo</a
			> if you want to report an issue or contribute!
		</p>
	</div>
</PageLayout>
