---
import { Icon } from "astro-icon/components";
import NoteListItem from "@/components/note/NoteListItem.astro";
import { getAllNotes, groupNotesByCategory } from "@/data/note";
import WikiLayout from "@/layouts/Wiki.astro";

const notes = await getAllNotes();
const categories = groupNotesByCategory(notes);

const meta = {
	description: "Read my collection of notes",
	title: "Notes",
};
---

<WikiLayout meta={meta}>
	<h1 class="title mb-3 flex items-center gap-3">
		Notes <a class="text-accent" href="/notes/rss.xml" target="_blank">
			<span class="sr-only">RSS feed</span>
			<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
		</a>
	</h1>
	<p class="mb-10 opacity-90">
		A growing wiki of {notes.length} notes across {categories.length} categories. Browse by category
		below or use the sidebar.
	</p>
	<div class="space-y-12">
		{
			categories.map((category) => (
				<section aria-labelledby={`cat-${category.slug}`}>
					<h2
						class="border-accent/30 text-accent-2 mb-4 flex items-baseline justify-between border-b pb-2 text-lg font-semibold"
						id={`cat-${category.slug}`}
					>
						<a class="hover:underline" href={`/notes/category/${category.slug}/`}>
							{category.name}
						</a>
						<span class="text-xs font-normal opacity-70">
							{category.notes.length} note{category.notes.length !== 1 && "s"}
						</span>
					</h2>
					<ul class="space-y-4">
						{category.notes.map((note) => (
							<NoteListItem note={note} />
						))}
					</ul>
				</section>
			))
		}
	</div>
</WikiLayout>
