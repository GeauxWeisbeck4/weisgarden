---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Note from "@/components/note/Note.astro";
import { getBacklinks, getNoteCategory, slugifyCategory } from "@/data/note";
import WikiLayout from "@/layouts/Wiki.astro";

// if you're using an adaptor in SSR mode, getStaticPaths wont work -> https://docs.astro.build/en/guides/routing/#modifying-the-slug-example-for-ssr
export const getStaticPaths = (async () => {
	const allNotes = await getCollection("note");
	return allNotes.map((note) => ({
		params: { slug: note.id },
		props: { note, backlinks: getBacklinks(note.id, allNotes) },
	}));
}) satisfies GetStaticPaths;

export type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note, backlinks } = Astro.props;
const { headings } = await render(note);
const categoryName = getNoteCategory(note);
const categorySlug = slugifyCategory(categoryName);

const meta = {
	description:
		note.data.description ||
		`Read about my note posted on: ${note.data.publishDate.toLocaleDateString()}`,
	title: note.data.title,
};
---

<WikiLayout
	breadcrumbs={[
		{ text: "Notes", url: "/notes/" },
		{ text: categoryName, url: `/notes/category/${categorySlug}/` },
		{ text: note.data.title },
	]}
	currentCategory={categorySlug}
	currentNoteId={note.id}
	headings={headings}
	meta={meta}
>
	<Note as="h1" note={note} />
	<section aria-labelledby="backlinks-heading" class="bg-note-bg/40 mt-12 rounded-md p-4">
		<h2
			class="mb-3 text-xs font-bold tracking-widest uppercase opacity-70"
			id="backlinks-heading"
		>
			Linked from {backlinks.length > 0 && `(${backlinks.length})`}
		</h2>
		{
			backlinks.length > 0 ? (
				<ul class="space-y-2">
					{backlinks.map((b) => (
						<li class="flex flex-wrap items-baseline justify-between gap-x-4">
							<a class="cactus-link text-accent-2 font-semibold" href={`/notes/${b.id}/`}>
								{b.data.title}
							</a>
							<FormattedDate class="text-xs opacity-70" date={b.data.publishDate} />
						</li>
					))}
				</ul>
			) : (
				<p class="text-xs opacity-70">
					No other notes link here yet. Link to this note with
					<code>[[{note.data.title}]]</code>.
				</p>
			)
		}
	</section>
	{
		note.data.tags.length > 0 && (
			<footer class="border-accent/30 mt-8 border-t border-dashed pt-4">
				<h2 class="mb-2 text-xs font-bold tracking-widest uppercase opacity-70">Tags</h2>
				<ul class="flex flex-wrap gap-2">
					{note.data.tags.map((tag) => (
						<li class="bg-note-bg rounded px-2 py-0.5 text-xs">#{tag}</li>
					))}
				</ul>
			</footer>
		)
	}
</WikiLayout>
