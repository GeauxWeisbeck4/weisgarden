---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import DateArchive from "@/components/DateArchive.astro";
import { type ArchiveYear, getAllPosts, getPostArchive } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async () => {
	const allPosts = (await getAllPosts()).sort(collectionDateSort);
	const archive = getPostArchive(allPosts);

	return archive.flatMap(({ year, months }) => {
		const yearPosts = allPosts.filter((p) => p.data.publishDate.getFullYear() === year);
		return [
			{
				params: { date: `${year}` },
				props: { archive, posts: yearPosts, year, month: undefined, monthLabel: undefined },
			},
			...months.map((m) => ({
				params: { date: `${year}/${m.slug}` },
				props: {
					archive,
					posts: yearPosts.filter((p) => p.data.publishDate.getMonth() + 1 === m.month),
					year,
					month: m.month,
					monthLabel: m.label,
				},
			})),
		];
	});
}) satisfies GetStaticPaths;

interface Props {
	archive: ArchiveYear[];
	posts: CollectionEntry<"post">[];
	year: number;
	month: number | undefined;
	monthLabel: string | undefined;
}

const { archive, posts, year, month, monthLabel } = Astro.props;

const heading = monthLabel ? `${monthLabel} ${year}` : `${year}`;
const meta = {
	description: `Posts published in ${heading}`,
	title: `Posts from ${heading}`,
};
---

<PageLayout meta={meta}>
	<div class="mb-12">
		<h1 class="title">Posts from {heading}</h1>
		<p class="text-muted mt-2">
			{posts.length}
			{posts.length === 1 ? "post" : "posts"} ·
			<a class="cactus-link" href="/posts/">
				All posts
			</a>
			{month && (
				<>
					{" · "}
					<a class="cactus-link" href={`/posts/archive/${year}/`}>
						All of {year}
					</a>
				</>
			)}
		</p>
	</div>
	<div class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8">
		<ul class="space-y-4 text-start">
			{posts.map((p) => (
				<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
					<PostPreview post={p} />
				</li>
			))}
		</ul>
		<aside>
			<DateArchive archive={archive} baseUrl="/posts/archive" current={{ year, month }} />
		</aside>
	</div>
</PageLayout>
