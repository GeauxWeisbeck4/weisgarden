---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import NoteCategoryList from "@/components/note/NoteCategoryList.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllNotes, groupNotesByCategory } from "@/data/note";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

// Pinned posts, newest first
const pinnedPosts = (await getAllPosts())
	.filter((p) => p.data.pinned)
	.sort(collectionDateSort) as CollectionEntry<"post">[];

// Notes, grouped by category
const noteCategories = groupNotesByCategory(await getAllNotes());
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-12">Andrew Weisbeck - Full Stack Developer</h1>
		<p class="mb-4">
			Welcome to my digital garden! Here you'll find a collection of my thoughts, ideas, and
			projects. I enjoy exploring new technologies and sharing my knowledge with the community. Feel
			free to browse through my posts and notes, and connect with me on social media!
		</p>
		<SocialList />
	</section>
	{pinnedPosts.length > 0 && (
		<section class="mt-16">
			<h2 class="text-accent mb-6 flex items-baseline justify-between gap-4 text-xl">
				Pinned Posts
				<a class="hover:text-link text-sm" href="/posts/">
					View all posts <span aria-hidden="true">→</span>
				</a>
			</h2>
			<ul class="space-y-4" role="list">
				{pinnedPosts.map((p) => (
					<li>
						<article class="bg-note-bg hover:bg-note-bg/40 w-full rounded-lg p-5 transition-colors duration-200 motion-reduce:transition-none">
							<h3 class="text-lg font-semibold">
								<a class="cactus-link" href={`/posts/${p.id}/`}>
									{p.data.title}
								</a>
							</h3>
							<FormattedDate class="text-muted mt-1 block text-sm" date={p.data.publishDate} />
							<p class="mt-3">{p.data.description}</p>
						</article>
					</li>
				))}
			</ul>
		</section>
	)}
	{noteCategories.length > 0 && (
		<section class="mt-16">
			<h2 class="text-accent mb-6 text-xl">
				<a href="/notes/">Notes</a>
			</h2>
			<NoteCategoryList categories={noteCategories} headingLevel="h3" />
		</section>
	)}
</PageLayout>
