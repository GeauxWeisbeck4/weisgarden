---
import type { CollectionEntry } from "astro:content";
import { getNoteCategory, getNoteLinks, slugifyCategory } from "@/data/note";

interface Props {
	notes: CollectionEntry<"note">[];
}

const { notes } = Astro.props;
const links = getNoteLinks(notes);
const categories = [...new Set(notes.map(getNoteCategory))].sort((a, b) => a.localeCompare(b));

const graph = {
	categories: categories.map((name, i) => ({ name, slug: slugifyCategory(name), color: i % 8 })),
	nodes: notes.map((n) => ({
		id: n.id,
		title: n.data.title,
		category: slugifyCategory(getNoteCategory(n)),
		url: `/notes/${n.id}/`,
	})),
	links,
};
---

<note-graph class="block">
	<div class="mb-3 flex flex-wrap items-center justify-between gap-3 text-xs">
		<ul aria-label="Legend" class="flex flex-wrap gap-x-4 gap-y-1">
			{
				graph.categories.map((c) => (
					<li class="flex items-center gap-1.5">
						<span
							aria-hidden="true"
							class="inline-block h-2.5 w-2.5 rounded-full"
							style={`background: var(--graph-c${c.color})`}
						/>
						<a class="hover:underline" href={`/notes/category/${c.slug}/`}>
							{c.name}
						</a>
					</li>
				))
			}
		</ul>
		<div class="flex items-center gap-3">
			<label class="flex cursor-pointer items-center gap-1.5">
				<input checked data-toggle-categories type="checkbox" />
				Group by category
			</label>
			<button
				class="border-accent/40 hover:bg-accent/15 rounded border px-2 py-0.5"
				data-reset
				type="button"
			>
				Reset view
			</button>
		</div>
	</div>
	<div
		class="graph-frame border-accent/30 bg-note-bg/30 relative h-[65vh] min-h-80 touch-none overflow-hidden rounded-md border select-none"
	>
		<svg aria-hidden="true" class="h-full w-full cursor-grab" data-svg>
			<g data-viewport>
				<g data-edges></g>
				<g data-nodes></g>
			</g>
		</svg>
		<p class="pointer-events-none absolute bottom-2 left-3 text-[0.7rem] opacity-60">
			Drag to move · scroll to zoom · click a note to open it
		</p>
	</div>
	<script is:inline data-graph type="application/json" set:html={JSON.stringify(graph)} />
</note-graph>

<style is:global>
	note-graph {
		--graph-c0: #0c7fb8;
		--graph-c1: #2f9e44;
		--graph-c2: #c2410c;
		--graph-c3: #9333ea;
		--graph-c4: #be185d;
		--graph-c5: #a16207;
		--graph-c6: #0f766e;
		--graph-c7: #4f46e5;
		--graph-edge: color-mix(in oklab, var(--color-global-text) 35%, transparent);
	}
	[data-theme="dark"] note-graph {
		--graph-c0: #5cc8ff;
		--graph-c1: #8ce99a;
		--graph-c2: #ffa94d;
		--graph-c3: #d0a5ff;
		--graph-c4: #faa2c1;
		--graph-c5: #ffd43b;
		--graph-c6: #63e6be;
		--graph-c7: #a5b4fc;
	}
	note-graph .g-edge {
		stroke: var(--graph-edge);
		stroke-width: 1.5;
		transition: opacity 150ms;
	}
	note-graph .g-edge.is-category {
		stroke-dasharray: 3 4;
		stroke-width: 1;
		opacity: 0.6;
	}
	note-graph .g-node {
		cursor: pointer;
		transition: opacity 150ms;
	}
	note-graph .g-node circle {
		stroke: var(--color-global-bg);
		stroke-width: 2;
	}
	note-graph .g-node.is-hub circle {
		fill: var(--color-global-bg) !important;
		stroke-width: 2.5;
	}
	note-graph .g-node text {
		fill: var(--color-global-text);
		font-size: 11px;
		paint-order: stroke;
		stroke: var(--color-global-bg);
		stroke-width: 3px;
		stroke-linejoin: round;
		pointer-events: none;
	}
	note-graph .g-node.is-hub text {
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 10px;
	}
	note-graph .g-node:focus-visible circle,
	note-graph .g-node.is-focus circle {
		stroke: var(--color-accent);
		stroke-width: 3;
	}
	note-graph svg.is-hovering .g-node:not(.is-lit),
	note-graph svg.is-hovering .g-edge:not(.is-lit) {
		opacity: 0.15;
	}
	note-graph svg.is-panning {
		cursor: grabbing;
	}
</style>

<script>
	interface GraphData {
		categories: { name: string; slug: string; color: number }[];
		nodes: { id: string; title: string; category: string; url: string }[];
		links: { source: string; target: string }[];
	}

	interface SimNode {
		id: string;
		label: string;
		url?: string;
		color: number;
		hub: boolean;
		r: number;
		x: number;
		y: number;
		vx: number;
		vy: number;
		fixed: boolean;
		el?: SVGGElement;
	}

	interface SimEdge {
		a: SimNode;
		b: SimNode;
		category: boolean;
		el?: SVGLineElement;
	}

	const SVG_NS = "http://www.w3.org/2000/svg";
	const svgEl = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string> = {}) => {
		const el = document.createElementNS(SVG_NS, tag);
		for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
		return el;
	};
	const truncate = (s: string, n = 32) => (s.length > n ? `${s.slice(0, n - 1)}…` : s);

	class NoteGraph extends HTMLElement {
		#nodes: SimNode[] = [];
		#edges: SimEdge[] = [];
		#data!: GraphData;
		#svg!: SVGSVGElement;
		#viewport!: SVGGElement;
		#view = { x: 0, y: 0, k: 1 };
		#alpha = 1;
		#frame = 0;
		#showCategories = true;
		#reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		connectedCallback() {
			this.#data = JSON.parse(this.querySelector("script[data-graph]")?.textContent ?? "{}");
			this.#svg = this.querySelector("svg[data-svg]")!;
			this.#viewport = this.querySelector("g[data-viewport]")!;

			const toggle = this.querySelector<HTMLInputElement>("[data-toggle-categories]")!;
			this.#showCategories = toggle.checked;
			toggle.addEventListener("change", () => {
				this.#showCategories = toggle.checked;
				this.#build();
			});
			this.querySelector("[data-reset]")?.addEventListener("click", () => this.#build());

			this.#bindPanZoom();
			new ResizeObserver(() => {
				if (this.#alpha <= 0.02) this.#fit();
			}).observe(this.#svg);
			this.#build();
		}

		disconnectedCallback() {
			cancelAnimationFrame(this.#frame);
		}

		get #size() {
			const { width, height } = this.#svg.getBoundingClientRect();
			return { w: width || 800, h: height || 500 };
		}

		#build() {
			const { categories, nodes, links } = this.#data;
			const colorOf = new Map(categories.map((c) => [c.slug, c.color]));
			const degree = new Map<string, number>();
			for (const l of links) {
				degree.set(l.source, (degree.get(l.source) ?? 0) + 1);
				degree.set(l.target, (degree.get(l.target) ?? 0) + 1);
			}

			const { w, h } = this.#size;
			const rand = (spread: number) => (Math.random() - 0.5) * spread;
			const byId = new Map<string, SimNode>();

			this.#nodes = nodes.map((n) => {
				const node: SimNode = {
					id: n.id,
					label: n.title,
					url: n.url,
					color: colorOf.get(n.category) ?? 0,
					hub: false,
					r: 6 + Math.min(degree.get(n.id) ?? 0, 6) * 1.5,
					x: w / 2 + rand(w * 0.6),
					y: h / 2 + rand(h * 0.6),
					vx: 0,
					vy: 0,
					fixed: false,
				};
				byId.set(n.id, node);
				return node;
			});

			this.#edges = links.flatMap((l) => {
				const a = byId.get(l.source);
				const b = byId.get(l.target);
				return a && b ? [{ a, b, category: false }] : [];
			});

			if (this.#showCategories) {
				for (const c of categories) {
					const hub: SimNode = {
						id: `category:${c.slug}`,
						label: c.name,
						url: `/notes/category/${c.slug}/`,
						color: c.color,
						hub: true,
						r: 9,
						x: w / 2 + rand(w * 0.4),
						y: h / 2 + rand(h * 0.4),
						vx: 0,
						vy: 0,
						fixed: false,
					};
					this.#nodes.push(hub);
					for (const n of nodes.filter((n) => n.category === c.slug)) {
						const member = byId.get(n.id);
						if (member) this.#edges.push({ a: hub, b: member, category: true });
					}
				}
			}

			this.#render();
			this.#view = { x: 0, y: 0, k: 1 };
			this.#applyView();
			this.#alpha = 1;
			if (this.#reducedMotion) {
				for (let i = 0; i < 300; i++) this.#tick();
				this.#draw();
				this.#fit();
			} else {
				this.#run();
			}
		}

		#render() {
			const edgesG = this.querySelector("g[data-edges]")!;
			const nodesG = this.querySelector("g[data-nodes]")!;
			edgesG.replaceChildren();
			nodesG.replaceChildren();

			for (const e of this.#edges) {
				e.el = svgEl("line", { class: e.category ? "g-edge is-category" : "g-edge" });
				edgesG.append(e.el);
			}

			const focusId = new URLSearchParams(location.search).get("focus");
			for (const n of this.#nodes) {
				const g = svgEl("g", {
					class: `g-node${n.hub ? " is-hub" : ""}${n.id === focusId ? " is-focus" : ""}`,
				});
				const circle = svgEl("circle", { r: String(n.r) });
				circle.style.fill = `var(--graph-c${n.color})`;
				if (n.hub) circle.style.stroke = `var(--graph-c${n.color})`;
				const text = svgEl("text", { x: String(n.r + 4), y: "4" });
				text.textContent = truncate(n.label);
				const title = svgEl("title");
				title.textContent = n.label;
				g.append(circle, text, title);
				this.#bindNode(g, n);
				n.el = g;
				nodesG.append(g);
			}
		}

		#tick() {
			const { w, h } = this.#size;
			const nodes = this.#nodes;
			const alpha = this.#alpha;

			// repulsion
			for (let i = 0; i < nodes.length; i++) {
				for (let j = i + 1; j < nodes.length; j++) {
					const a = nodes[i]!;
					const b = nodes[j]!;
					let dx = b.x - a.x;
					let dy = b.y - a.y;
					let d2 = dx * dx + dy * dy;
					if (d2 < 0.01) {
						dx = Math.random() - 0.5;
						dy = Math.random() - 0.5;
						d2 = 0.25;
					}
					const force = (2600 * alpha) / d2;
					const d = Math.sqrt(d2);
					const fx = (dx / d) * force;
					const fy = (dy / d) * force;
					a.vx -= fx;
					a.vy -= fy;
					b.vx += fx;
					b.vy += fy;
				}
			}
			// springs
			for (const e of this.#edges) {
				const dx = e.b.x - e.a.x;
				const dy = e.b.y - e.a.y;
				const d = Math.sqrt(dx * dx + dy * dy) || 1;
				const rest = e.category ? 70 : 110;
				const k = (e.category ? 0.04 : 0.06) * alpha;
				const f = (d - rest) * k;
				const fx = (dx / d) * f;
				const fy = (dy / d) * f;
				e.a.vx += fx;
				e.a.vy += fy;
				e.b.vx -= fx;
				e.b.vy -= fy;
			}
			// gravity to centre + integrate
			for (const n of nodes) {
				n.vx += (w / 2 - n.x) * 0.012 * alpha;
				n.vy += (h / 2 - n.y) * 0.012 * alpha;
				if (n.fixed) {
					n.vx = 0;
					n.vy = 0;
					continue;
				}
				n.vx *= 0.6;
				n.vy *= 0.6;
				n.x += n.vx;
				n.y += n.vy;
			}
			this.#alpha = Math.max(0, alpha * 0.985);
		}

		#draw() {
			for (const e of this.#edges) {
				e.el?.setAttribute("x1", String(e.a.x));
				e.el?.setAttribute("y1", String(e.a.y));
				e.el?.setAttribute("x2", String(e.b.x));
				e.el?.setAttribute("y2", String(e.b.y));
			}
			for (const n of this.#nodes) n.el?.setAttribute("transform", `translate(${n.x},${n.y})`);
		}

		#run() {
			cancelAnimationFrame(this.#frame);
			const step = () => {
				this.#tick();
				this.#draw();
				if (this.#alpha > 0.02) this.#frame = requestAnimationFrame(step);
				else this.#fit();
			};
			this.#frame = requestAnimationFrame(step);
		}

		#reheat(alpha = 0.3) {
			if (this.#reducedMotion) return;
			this.#alpha = Math.max(this.#alpha, alpha);
			this.#run();
		}

		/** zoom/pan so every node is visible */
		#fit() {
			if (!this.#nodes.length) return;
			const { w, h } = this.#size;
			const pad = 60;
			const xs = this.#nodes.map((n) => n.x);
			const ys = this.#nodes.map((n) => n.y);
			const minX = Math.min(...xs) - pad;
			const maxX = Math.max(...xs) + pad + 140; // room for labels
			const minY = Math.min(...ys) - pad;
			const maxY = Math.max(...ys) + pad;
			const k = Math.min(1.6, w / (maxX - minX), h / (maxY - minY));
			this.#view = {
				k,
				x: w / 2 - ((minX + maxX) / 2) * k,
				y: h / 2 - ((minY + maxY) / 2) * k,
			};
			this.#applyView();
		}

		#applyView() {
			const { x, y, k } = this.#view;
			this.#viewport.setAttribute("transform", `translate(${x},${y}) scale(${k})`);
		}

		#toGraph(clientX: number, clientY: number) {
			const rect = this.#svg.getBoundingClientRect();
			return {
				x: (clientX - rect.left - this.#view.x) / this.#view.k,
				y: (clientY - rect.top - this.#view.y) / this.#view.k,
			};
		}

		#highlight(node?: SimNode) {
			this.#svg.classList.toggle("is-hovering", !!node);
			if (!node) return;
			const lit = new Set<SimNode>([node]);
			for (const e of this.#edges) {
				const on = e.a === node || e.b === node;
				e.el?.classList.toggle("is-lit", on);
				if (on) {
					lit.add(e.a);
					lit.add(e.b);
				}
			}
			for (const n of this.#nodes) n.el?.classList.toggle("is-lit", lit.has(n));
		}

		#bindNode(g: SVGGElement, n: SimNode) {
			let start: { x: number; y: number } | undefined;
			let moved = false;

			g.addEventListener("pointerenter", () => this.#highlight(n));
			g.addEventListener("pointerleave", () => !start && this.#highlight());
			g.addEventListener("pointerdown", (e) => {
				e.stopPropagation();
				g.setPointerCapture(e.pointerId);
				start = { x: e.clientX, y: e.clientY };
				moved = false;
				n.fixed = true;
			});
			g.addEventListener("pointermove", (e) => {
				if (!start) return;
				if (Math.hypot(e.clientX - start.x, e.clientY - start.y) > 4) moved = true;
				if (!moved) return;
				const p = this.#toGraph(e.clientX, e.clientY);
				n.x = p.x;
				n.y = p.y;
				this.#draw();
				this.#reheat(0.15);
			});
			g.addEventListener("pointerup", () => {
				start = undefined;
				n.fixed = false;
				if (!moved && n.url) window.location.href = n.url;
			});
		}

		#bindPanZoom() {
			let pan: { x: number; y: number; vx: number; vy: number } | undefined;
			this.#svg.addEventListener("pointerdown", (e) => {
				this.#svg.setPointerCapture(e.pointerId);
				this.#svg.classList.add("is-panning");
				pan = { x: e.clientX, y: e.clientY, vx: this.#view.x, vy: this.#view.y };
			});
			this.#svg.addEventListener("pointermove", (e) => {
				if (!pan) return;
				this.#view.x = pan.vx + e.clientX - pan.x;
				this.#view.y = pan.vy + e.clientY - pan.y;
				this.#applyView();
			});
			const end = () => {
				pan = undefined;
				this.#svg.classList.remove("is-panning");
			};
			this.#svg.addEventListener("pointerup", end);
			this.#svg.addEventListener("pointercancel", end);
			this.#svg.addEventListener(
				"wheel",
				(e) => {
					e.preventDefault();
					const rect = this.#svg.getBoundingClientRect();
					const mx = e.clientX - rect.left;
					const my = e.clientY - rect.top;
					const k = Math.min(4, Math.max(0.25, this.#view.k * Math.exp(-e.deltaY * 0.0015)));
					const ratio = k / this.#view.k;
					this.#view = {
						k,
						x: mx - (mx - this.#view.x) * ratio,
						y: my - (my - this.#view.y) * ratio,
					};
					this.#applyView();
				},
				{ passive: false },
			);
		}
	}

	customElements.define("note-graph", NoteGraph);
</script>
