---
import ChevronToggle from "@/components/note/ChevronToggle.astro";
import NoteListItem from "@/components/note/NoteListItem.astro";
import type { NoteCategory } from "@/data/note";

interface Props {
	categories: NoteCategory[];
	/** heading tag for each category title, so it nests correctly under the page's headings */
	headingLevel?: "h2" | "h3";
}

const { categories, headingLevel: Heading = "h2" } = Astro.props;
---

<div class="grid grid-cols-2 space-x-4">
	{categories.map((category) => (
		<section aria-labelledby={`cat-${category.slug}`}>
			<Heading
				class="border-accent/30 text-accent-2 mb-4 flex items-center gap-2 border-b pb-2 text-lg font-semibold"
				id={`cat-${category.slug}`}
			>
				<ChevronToggle
					controls={`cat-${category.slug}-notes`}
					label={`Show notes in ${category.name}`}
				/>
				<a class="hover:underline" href={`/notes/category/${category.slug}/`}>
					{category.name} ({category.notes.length})
					<span class="sr-only">note{category.notes.length !== 1 && "s"}</span>
				</a>
			</Heading>
			<ul class="mb-6 space-y-4" hidden id={`cat-${category.slug}-notes`}>
				{category.notes.map((note) => (
					<NoteListItem note={note} />
				))}
			</ul>
		</section>
	))}
</div>
